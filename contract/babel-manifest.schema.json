{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBabelDragon/babel-interface/contract/babel-manifest.schema.json",
  "title": "BabelManifest",
  "type": "object",
  "required": ["babel", "identity", "purpose", "status"],
  "properties": {
    "babel": { "type": ["string", "number"] },
    "identity": {
      "type": "object",
      "required": ["name", "repo"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "repo": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "kind": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "purpose": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["operational", "experimental", "stub", "archived", "protocol"]
    },
    "entrypoints": { "type": "array" },
    "runtime": { "type": "object" },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "capabilities": { "type": "array" },
    "schemas": { "type": "array" },
    "related": { "type": "array" },
    "operations": { "type": "object" },
    "notes": { "type": "string" }
  }
}
