#!/usr/bin/env python3
"""MetaField software adapter. No hardware. No network. No mutation.

tick(dt) returns a derived FieldTick. World here is a deterministic counter
so the interface loop can close without the C++ engine.
"""

from __future__ import annotations

import hashlib
import json
import sys


def tick(payload: dict) -> dict:
    dt = float(payload.get("dt", 0.0))
    t = dt
    tick_index = 1
    world = f"tick={tick_index};dt={dt:.9f}"
    digest = hashlib.sha256(world.encode("utf-8")).hexdigest()[:16]
    return {
        "kind": "FieldTick",
        "tick": tick_index,
        "dt": dt,
        "t": t,
        "world_hash": digest,
        "deltas": [],
        "source_class": "derived",
    }


HANDLERS = {"tick": tick}


def main() -> int:
    capability = sys.argv[1] if len(sys.argv) > 1 else "tick"
    raw = sys.stdin.read() or "{}"
    try:
        request = json.loads(raw)
    except json.JSONDecodeError as exc:
        json.dump(
            {
                "protocol": "babel.result.v1",
                "ok": False,
                "capability": capability,
                "error": {"code": "INPUT_MALFORMED", "message": str(exc)},
            },
            sys.stdout,
        )
        return 0
    if request.get("capability"):
        capability = str(request["capability"])
    payload = request.get("input") if isinstance(request.get("input"), dict) else {}
    handler = HANDLERS.get(capability)
    if handler is None:
        json.dump(
            {
                "protocol": "babel.result.v1",
                "ok": False,
                "capability": capability,
                "error": {"code": "CAPABILITY_NOT_FOUND", "message": capability},
            },
            sys.stdout,
        )
        return 0
    output = handler(payload)
    json.dump(
        {
            "protocol": "babel.result.v1",
            "ok": True,
            "capability": capability,
            "output": output,
        },
        sys.stdout,
    )
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
